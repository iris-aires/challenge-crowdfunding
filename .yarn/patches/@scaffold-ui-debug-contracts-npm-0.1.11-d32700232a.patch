diff --git a/dist/esm/utils/ethUsdDisplay.js b/dist/esm/utils/ethUsdDisplay.js
new file mode 100644
index 0000000000000000000000000000000000000000..b9d023d8e7d2c3c1d13b79cf18ed2ae269eb11a4
--- /dev/null
+++ b/dist/esm/utils/ethUsdDisplay.js
@@ -0,0 +1,23 @@
+import { parseEther, formatEther, maxUint256 } from "viem";
+export const parseEthInput = value => {
+    if (!/^\d+(?:\.\d{1,18})?$/.test(value)) return undefined;
+    try {
+        const amount = parseEther(value);
+        return amount <= maxUint256 ? amount : undefined;
+    } catch { return undefined; }
+};
+export const formatUsdValue = value => {
+    const cents = value / 10000000000000000n;
+    return "$" + (cents / 100n).toLocaleString("en-US") + "." + (cents % 100n).toString().padStart(2, "0") + " USD";
+};
+export const formatDebugValue = (name, value) => {
+    if (typeof value !== "bigint") return undefined;
+    if (name === "threshold" || name === "totalFunded") return formatEther(value) + " ETH";
+    if (name === "timeLeft") {
+        // Round upwards so a live campaign never appears to have zero days remaining.
+        const hundredths = (value * 100n + 86399n) / 86400n;
+        const fraction = (hundredths % 100n).toString().padStart(2, "0").replace(/0+$/, "");
+        return (hundredths / 100n).toString() + (fraction ? "." + fraction : "") + (hundredths === 100n ? " day" : " days");
+    }
+    return undefined;
+};
diff --git a/dist/esm/utils/formatDeadline.js b/dist/esm/utils/formatDeadline.js
new file mode 100644
index 0000000000000000000000000000000000000000..a37870902124b91018c3324532c5c8d7908b142b
--- /dev/null
+++ b/dist/esm/utils/formatDeadline.js
@@ -0,0 +1,12 @@
+/** Format Unix seconds in the viewer's local timezone; keep unsafe values unformatted. */
+export const formatDeadline = timestamp => {
+    if (typeof timestamp !== "bigint" || timestamp < 0n || timestamp > 8640000000000n) return undefined;
+    const date = new Date(Number(timestamp) * 1000);
+    if (!Number.isFinite(date.getTime())) return undefined;
+    const year = date.getFullYear().toString().padStart(4, "0");
+    const month = (date.getMonth() + 1).toString().padStart(2, "0");
+    const day = date.getDate().toString().padStart(2, "0");
+    const zone = new Intl.DateTimeFormat().resolvedOptions().timeZone;
+    const fullTime = date.toLocaleString("en-GB", { timeZoneName: "longOffset", hour12: false }).replace("GMT", "UTC");
+    return { text: year + "-" + month + "-" + day, dateTime: date.toISOString(), title: fullTime + " (" + zone + ") · Unix timestamp: " + timestamp };
+};
